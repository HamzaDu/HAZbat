From 056b77674e64ffc51070a971e8465f9bee91556d Mon Sep 17 00:00:00 2001
From: Andrew Lawson <andrewjllawson@gmail.com>
Date: Thu, 15 Oct 2026 10:13:47 +0100
Subject: [PATCH] Add WMG / University of Warwick branding

- Logos in static/img (white, white + colour mark, full colour, black),
  resized to 900px wide for the web.
- Nav bar: white logo linking to the WMG site, left of 'BMAC by HAZbat'.
- Footer on every page: colour logo and 'Developed by the Battery
  Materials & Cells Group, WMG, University of Warwick'.
- Login page: sign-in form in a card under the colour logo.
- Lineage 'Save as PDF': colour logo in the printed header.
- Basic card: small black logo under the QR code.
- Graph page: faint white watermark in the corner of the graph.
- Footer and watermark are hidden when printing; nav logo and footer
  adapt on narrow screens.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Crj125Fro16MPuRzP8sX2x
---
 static/css/hazbat.css           |  32 ++++++++++++++++++++++++++++++++
 static/img/wmg-black.png        | Bin 0 -> 53918 bytes
 static/img/wmg-colour.png       | Bin 0 -> 12750 bytes
 static/img/wmg-white-colour.png | Bin 0 -> 79301 bytes
 static/img/wmg-white.png        | Bin 0 -> 50742 bytes
 templates/base.html             |   7 +++++++
 templates/card.html             |   1 +
 templates/graph.html            |   5 ++++-
 templates/lineage.html          |   2 +-
 templates/login.html            |   4 ++++
 10 files changed, 49 insertions(+), 2 deletions(-)
 create mode 100644 static/img/wmg-black.png
 create mode 100644 static/img/wmg-colour.png
 create mode 100644 static/img/wmg-white-colour.png
 create mode 100644 static/img/wmg-white.png

diff --git a/static/css/hazbat.css b/static/css/hazbat.css
index 6c45735..5db9185 100644
--- a/static/css/hazbat.css
+++ b/static/css/hazbat.css
@@ -234,3 +234,35 @@ button.btn-outline { margin: 0; font-family: inherit; cursor: pointer; }
     a { color: inherit !important; text-decoration: none !important; }
     canvas { max-width: 100% !important; }
 }
+
+/* --- WMG / University of Warwick branding --- */
+.nav-logo { display: inline-flex; align-items: center; }
+.nav-logo img { height: 34px; display: block; }
+.nav-divider { width: 1px; height: 28px; background: rgba(255,255,255,0.35); margin-right: 6px; }
+.site-footer { margin-top: 48px; background: #fff; border-top: 1px solid var(--hz-border); padding: 18px 32px;
+               display: flex; align-items: center; gap: 18px; font-size: 13px; color: var(--hz-muted); }
+.site-footer img { height: 40px; }
+.site-footer-text { border-left: 1px solid var(--hz-border); padding-left: 18px; }
+.site-footer-text b { color: var(--hz-navy); }
+.site-footer-copy { margin-left: auto; }
+.login-card { max-width: 420px; margin: 0 auto; background: #fff; border-radius: 14px;
+              box-shadow: 0 4px 14px rgba(0,0,0,0.12); padding: 28px 24px 24px; }
+.login-logo { text-align: center; }
+.login-logo img { height: 64px; }
+.login-card h1 { margin: 12px 0 0; font-size: 22px; color: var(--hz-navy); text-align: center; }
+.login-sub { margin: 6px 0 0; text-align: center; color: var(--hz-muted); font-size: 13px; }
+.card-logo { margin-top: 14px; padding-top: 12px; border-top: 1px solid #e3e6ee; }
+.card-logo img { height: 24px; opacity: 0.85; }
+.graph-watermark { position: absolute; right: 18px; bottom: 16px; height: 40px; opacity: 0.35; pointer-events: none; }
+.print-brand { display: inline-flex; align-items: center; gap: 14px; }
+.print-brand img { height: 44px; }
+.print-brand > span { padding-left: 14px; border-left: 1px solid var(--hz-border); }
+@media print {
+    .site-footer, .graph-watermark { display: none !important; }
+    .print-head { align-items: center; }
+}
+@media (max-width: 760px) {
+    .site-footer { flex-wrap: wrap; padding: 16px; }
+    .site-footer-copy { margin-left: 0; }
+    .nav-divider, .nav-logo { display: none; }
+}
