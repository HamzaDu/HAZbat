// Dev environment for Hazbat: the project's own image, with its PostgreSQL inside it (START_LOCAL_DB).
// The repository is mounted over /app and uvicorn reloads when files change (RELOAD).
// The entrypoint builds the database from schemas/ and then loads the dev data in db-init/02-dev-seed.sql (SEED_SQL).
// The config file is .devcontainer/hazbat.ini, with dev-only passwords. Nothing is kept when the container is rebuilt.
{
  "name": "Hazbat",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "containerEnv": {
    "START_LOCAL_DB": "1",
    "RELOAD": "1",
    "SEED_SQL": "/app/.devcontainer/db-init/02-dev-seed.sql"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/hazbat.ini,target=/etc/hazbat/hazbat.ini,type=bind"
  ],

  "forwardPorts": [8000, 5432],
  "portsAttributes": {
    "8000": { "label": "Hazbat app", "onAutoForward": "openBrowser" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "sqltools.connections": [
          {
            "name": "Hazbat dev DB",
            "driver": "PostgreSQL",
            "server": "localhost",
            "port": 5432,
            "database": "bmac",
            "username": "hazbat_admin",
            "password": "dev"
          }
        ]
      }
    }
  }
}
